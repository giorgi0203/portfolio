{
  "name": "bug-safari",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bug-safari/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/bug-safari"],
      "options": {
        "command": "node_modules/.bin/vite build --config apps/bug-safari/vite.config.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node_modules/.bin/vite --config apps/bug-safari/vite.config.ts --host 127.0.0.1 --port 4211"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test apps/bug-safari/testsengine/*.test.mjs"
      }
    }
  }
}
