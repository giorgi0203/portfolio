{
  "name": "split-supra",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/split-supra/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/split-supra"],
      "options": {
        "command": "node_modules/.bin/vite build --config apps/split-supra/vite.config.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node_modules/.bin/vite --config apps/split-supra/vite.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test apps/split-supra/tests/*.test.mjs" }
    }
  }
}
