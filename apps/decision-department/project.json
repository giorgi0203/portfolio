{
  "name": "decision-department",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/decision-department/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/decision-department"],
      "options": { "command": "node apps/decision-department/build.mjs" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node_modules/.bin/vite --config apps/decision-department/vite.config.ts --host 127.0.0.1 --port 4210"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test apps/decision-department/tests/*.test.mjs"
      }
    }
  }
}
